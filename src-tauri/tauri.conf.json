{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluorCast",
  "version": "../package.json",
  "identifier": "org.fluorcast.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FluorCast",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Education",
    "publisher": "FluorCast",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Desktop controller for FluorCast predictions",
    "longDescription": "Prepare, submit, monitor, and manage molecular fluorescence prediction jobs running on Nibi.",
    "resources": [
      "resources/putty/*"
    ]
  }
}
